  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>You now have access to the Weapon Wheel! You can bring it up by pressing
    X. This allows you to choose your weapon. Time slows down in this state but you
    are still vulnerable so be careful! Here's a brief description of each base weapon.</b>\n\n<b>Pistol</b>
    - A simple pistol. Weak against armor, and doesn\u2019t do a lot of damage, but
    good accuracy.\n\n<b>Carbine</b> - A bullpup assault rifle with high rate of
    fire, poor accuracy, and fair damage to make it useful in close and medium ranges.\n\n<b>Shotgun</b>
    - A lever-action shotgun that excels in close-up encounters with many pellets
    that do little damage, but together do massive damage. \n\n<b>Marksman Rifle</b>
    - A slow-rate-of-fire DMR that does exceptionally well with pinpoint headshots
    and weakpoint-shots. High accuracy with poor rate of fire.\n\n<b>SMG</b> - A
    high-rate-of-fire SMG that shoots in quick bursts. These bursts are close together,
    but spread between bursts. Incredibly high rate of fire mixed with poor accuracy"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
